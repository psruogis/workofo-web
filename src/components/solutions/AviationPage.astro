<BottomDemoCta
  demoHref={demoHref}
  headingId="av-cta-heading"
  title="Book a demo built around your flight plan."
  sub="Share your flight schedule and rules, and we'll show you the roster Workofo would build."
  note="We reply within one working day."
  tailoredSub="Your flight plan, teams and rules"
  ariaLabel="Notifications: request received, demo tailored to your flight plan, demo booked."
/>

<script is:inline>
(function () {
  const faq = document.querySelector('[data-av-faq]');
  if (!faq) return;
  const more = faq.querySelector('[data-av-faq-more]');
  const btn = faq.querySelector('[data-av-faq-toggle]');
  if (!more || !btn) return;
  const items = Array.from(more.querySelectorAll('details'));
  function setExpanded(on) {
    faq.classList.toggle('is-expanded', on);
    btn.setAttribute('aria-expanded', on ? 'true' : 'false');
    if (on) {
      more.hidden = false;
      items.forEach(function (el, idx) {
        el.setAttribute('data-reveal', '');
        el.classList.remove('is-in');
        window.setTimeout(function () {
          el.classList.add('is-in');
        }, 40 + idx * 70);
      });
    } else {
      more.hidden = true;
      items.forEach(function (el) {
        el.classList.remove('is-in');
        el.removeAttribute('data-reveal');
      });
    }
  }
  btn.addEventListener('click', function () {
    setExpanded(!faq.classList.contains('is-expanded'));
  });
})();
</script>
</article>
