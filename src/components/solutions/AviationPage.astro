        <span class="wf-ic">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="16" rx="2"></rect>
            <path d="M3 10h18M8 3v4M16 3v4"></path>
          </svg>
        </span>
        <div class="wf-txt">
          <span class="wf-t">Shift offered to 6 ramp agents</span>
          <span class="wf-s">Morning wave · Tue 05:30–09:30</span>
        </div>
        <span class="wf-tm">05:12</span>
      </div>
      <div class="wf-card wf-b" aria-hidden="true">
        <span class="wf-avw">
          <span class="wf-av">LV</span>
          <span class="wf-ck">
            <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12l5 5 9-10"></path>
            </svg>
          </span>
        </span>
        <div class="wf-txt">
          <span class="wf-t">Lina accepted the shift</span>
          <span class="wf-s">Morning wave covered · Licences OK</span>
        </div>
        <span class="wf-tm">05:14</span>
      </div>
    </div>
  </div>
</div>

</div>
</div>

<script>
  (() => {
    const el = document.querySelector('.aviation-page [data-wf-stk]');
    if (!el) return;
    const show = () => el.classList.add('is-in');
    if (!('IntersectionObserver' in window)) {
      show();
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            show();
            io.disconnect();
          }
        });
      },
      { threshold: 0.4 },
    );
    io.observe(el);
  })();
</script>

<!-- Challenge / why schedules fail -->
