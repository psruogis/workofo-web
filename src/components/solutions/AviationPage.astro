      <span class="industry-hero__fade retail-hero__fade" aria-hidden="true"></span>
    </div>
    <div
      class="wf-stk"
      data-wf-stk
      role="status"
      aria-label="Extra shift offered to ramp agents, then accepted by Lina."
    >
