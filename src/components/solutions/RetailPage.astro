---
/**
 * Retail industry subpage — rebuilt from Max retail-page-updated.html mock.
 * Icons and visual treatments from the HTML bundle. Workofo gutters/tokens/buttons.
 * Labor spelling; no Calculate CTA; Overview not sticky; Workofo casing.
 */
import { type Locale } from '../../lib/locales';
import { localePath } from '../../lib/paths';
import RetailPanel from './RetailPanel';
import BottomDemoCta from '../sections/BottomDemoCta.astro';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props as Props;
const demoHref = localePath(locale, '/get-in-touch');
const homeHref = localePath(locale, '/');
---
<article class="retail-page">
<!-- Industry split-hero (homepage vertical center; 55/45 copy | photo) -->
<div id="overview" class="industry-hero retail-hero">
<div class="industry-hero__in retail-hero__in">

<div class="industry-hero__copy retail-hero__copy">
<nav aria-label="Breadcrumb" class="retail-breadcrumb">
<span>Industries</span>
<span aria-hidden="true">/</span>
<span class="retail-breadcrumb__current">Retail</span>
</nav>
<div class="industry-hero__intro retail-hero__intro" data-reveal>
<h1 class="industry-hero__title" data-split>Retail scheduling software that staffs your stores around customer traffic</h1>
<p class="lede industry-hero__lede">Workofo forecasts footfall and workload, applies your labor rules and builds retail staff schedules automatically. Put the right skills on the shop floor when customers need help.</p>
<div class="hero__actions industry-hero__actions">
<a class="btn btn--primary btn--cta" href={demoHref}>Book a demo</a>
<a class="btn btn--ghost btn--cta" href="#how">
  See how it works
  <svg class="btn__icon btn__icon--trail btn__icon--down" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
    <path d="M7 2.5v9M3.5 8 7 11.5 10.5 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>
</div>
</div>
</div>

<div class="industry-hero__media retail-hero__media" data-reveal>
  <div class="industry-hero__photo retail-hero__photo">
    <div class="industry-hero__frame retail-hero__frame">
      <img
        class="industry-hero__img retail-hero__img"
        src="/industries/shift-notification-barista.webp"
        alt="Barista pouring steamed milk into a coffee"
        width="720"
        height="780"
        decoding="async"
        fetchpriority="high"
      />
      <span class="industry-hero__fade retail-hero__fade" aria-hidden="true"></span>
    </div>
    <div
      class="wf-stk"
      data-wf-stk
      role="status"
      aria-label="Open shift Saturday 07:00 to 13:00 at store 14 sent to 12 colleagues. Sara accepted the shift, schedule updated."
    >
      <div class="wf-card wf-a" aria-hidden="true">
        <span class="wf-ic">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="16" rx="2"></rect>
            <path d="M3 10h18M8 3v4M16 3v4"></path>
          </svg>
        </span>
        <div class="wf-txt">
          <span class="wf-t">Shift sent to 12 colleagues</span>
          <span class="wf-s">Sat 07:00-13:00 · Store 14</span>
        </div>
        <span class="wf-tm">09:12</span>
      </div>
      <div class="wf-card wf-b" aria-hidden="true">
        <span class="wf-avw">
          <span class="wf-av">SM</span>
          <span class="wf-ck">
            <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12l5 5 9-10"></path>
            </svg>
          </span>
        </span>
        <div class="wf-txt">
          <span class="wf-t">Sara accepted the shift</span>
          <span class="wf-s">Schedule updated · Rules OK</span>
        </div>
        <span class="wf-tm">09:14</span>
      </div>
    </div>
  </div>
</div>

</div>
</div>

<script>
  (() => {
    const el = document.querySelector('[data-wf-stk]');
    if (!el) return;
    const show = () => el.classList.add('is-in');
    if (!('IntersectionObserver' in window)) {
      show();
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            show();
            io.disconnect();
          }
        });
      },
      { threshold: 0.4 },
    );
    io.observe(el);
  })();
</script>

<!-- 2. Why schedules fail (workofo-retail-section2.html layout/icons; site type/spacing) -->
<section class="sec retail-s2" style="background:#FFFFFF" aria-labelledby="retail-s2-heading">
