<script is:inline>
(function () {
  const root = document.querySelector('[data-retail-stories]');
  const page = document.querySelector('.retail-page');
  if (!root || !page) return;
  const stories = Array.from(root.querySelectorAll('[data-story]'));
  if (!stories.length) return;
  const label = page.querySelector('.retail-stories-label');
  const dots = Array.from(root.querySelectorAll('[data-story-dot]'));
  const prev = page.querySelector('[data-story-prev]');
  const next = page.querySelector('[data-story-next]');
  let i = 0;
  function show(n) {
    i = (n + stories.length) % stories.length;
    stories.forEach(function (el, idx) {
      if (idx === i) el.removeAttribute('hidden');
      else el.setAttribute('hidden', '');
    });
    if (label) label.textContent = i + 1 + ' / ' + stories.length;
    dots.forEach(function (d, idx) {
      var on = idx === i;
      d.classList.toggle('is-active', on);
      d.setAttribute('aria-selected', on ? 'true' : 'false');
    });
  }
  if (prev) prev.addEventListener('click', function () { show(i - 1); });
  if (next) next.addEventListener('click', function () { show(i + 1); });
  dots.forEach(function (d) {
    d.addEventListener('click', function () {
      var n = Number(d.getAttribute('data-story-dot'));
      if (!Number.isNaN(n)) show(n);
    });
  });
  show(0);
})();
(function () {
  const faq = document.querySelector('[data-retail-faq]');
  if (!faq) return;
  const more = faq.querySelector('[data-retail-faq-more]');
  const btn = faq.querySelector('[data-retail-faq-toggle]');
  if (!more || !btn) return;
  const items = Array.from(more.querySelectorAll('details'));
  function setExpanded(on) {
    faq.classList.toggle('is-expanded', on);
    btn.setAttribute('aria-expanded', on ? 'true' : 'false');
    if (on) {
      more.hidden = false;
      items.forEach(function (el, idx) {
        el.setAttribute('data-reveal', '');
        el.classList.remove('is-in');
        window.setTimeout(function () {
          el.classList.add('is-in');
        }, 40 + idx * 70);
      });
    } else {
      more.hidden = true;
      items.forEach(function (el) {
        el.classList.remove('is-in');
        el.removeAttribute('data-reveal');
      });
    }
  }
  btn.addEventListener('click', function () {
    setExpanded(!faq.classList.contains('is-expanded'));
  });
})();
</script>
</article>
