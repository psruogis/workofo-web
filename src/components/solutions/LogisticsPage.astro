---
/**
 * Logistics industry subpage - duplicated from Aviation/Contact Centre, adapted from Logistics.dc.html.
 * Same type, buttons, gutters, mobile pass, hero, breadcrumbs, FAQ, bottom CTA as retail/CC.
 * US spelling labor; no Calculate; Workofo casing; no More industries / workforce-mgmt band.
 */
import { type Locale } from '../../lib/locales';
import { localePath } from '../../lib/paths';
import LogisticsPanel from './LogisticsPanel';
import BottomDemoCta from '../sections/BottomDemoCta.astro';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props as Props;
const demoHref = localePath(locale, '/get-in-touch');
const homeHref = localePath(locale, '/');
---
<article class="retail-page logistics-page">
<!-- Industry split-hero (homepage vertical center; 55/45 copy | photo) -->
<div id="overview" class="industry-hero retail-hero">
<div class="industry-hero__in retail-hero__in">

<div class="industry-hero__copy retail-hero__copy">
<nav aria-label="Breadcrumb" class="retail-breadcrumb">
<span>Industries</span>
<span aria-hidden="true">/</span>
<span class="retail-breadcrumb__current">Logistics</span>
</nav>
<div class="industry-hero__intro retail-hero__intro" data-reveal>
<h1 class="industry-hero__title" data-split>Logistics scheduling software built around your volumes</h1>
<p class="lede industry-hero__lede">Workofo forecasts pallets, orders and shipments, plans every zone and shift, and shares staff across your warehouses.</p>
<div class="hero__actions industry-hero__actions">
<a class="btn btn--primary btn--cta" href={demoHref}>Book a demo</a>
<a class="btn btn--ghost btn--cta" href="#how">
  See how it works
  <svg class="btn__icon btn__icon--trail btn__icon--down" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
    <path d="M7 2.5v9M3.5 8 7 11.5 10.5 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>
</div>
</div>
</div>

<div class="industry-hero__media retail-hero__media" data-reveal>
  <div class="industry-hero__photo retail-hero__photo">
    <div class="industry-hero__frame retail-hero__frame">
      <img
        class="industry-hero__img retail-hero__img"
        src="/industries/logistics-hero.jpg"
        alt="Warehouse team at work"
        width="720"
        height="780"
        decoding="async"
        fetchpriority="high"
      />
      <span class="industry-hero__fade retail-hero__fade" aria-hidden="true"></span>
    </div>
    <div
      class="wf-stk"
      data-wf-stk
      role="status"
      aria-label="Extra shift offered to pickers, then accepted by Ahmed."
    >
      <div class="wf-card wf-a" aria-hidden="true">
        <span class="wf-ic">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="16" rx="2"></rect>
            <path d="M3 10h18M8 3v4M16 3v4"></path>
          </svg>
        </span>
        <div class="wf-txt">
          <span class="wf-t">Shift offered to 5 pickers</span>
          <span class="wf-s">Zone B · Fri 06:00-14:00</span>
        </div>
        <span class="wf-tm">04:51</span>
      </div>
      <div class="wf-card wf-b" aria-hidden="true">
        <span class="wf-avw">
          <span class="wf-av">AH</span>
          <span class="wf-ck">
            <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12l5 5 9-10"></path>
            </svg>
          </span>
        </span>
        <div class="wf-txt">
          <span class="wf-t">Ahmed accepted the shift</span>
          <span class="wf-s">Friday peak covered · Rules OK</span>
        </div>
        <span class="wf-tm">04:53</span>
      </div>
    </div>
  </div>
</div>

</div>
</div>

<script>
  (() => {
    const el = document.querySelector('.logistics-page [data-wf-stk]');
    if (!el) return;
    const show = () => el.classList.add('is-in');
    if (!('IntersectionObserver' in window)) {
      show();
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            show();
            io.disconnect();
          }
        });
      },
      { threshold: 0.4 },
    );
    io.observe(el);
  })();
</script>

<!-- Challenge / why schedules fail -->
<section class="sec retail-s2" style="background:#FFFFFF" aria-labelledby="lg-s2-heading">
  <div class="in retail-s2__in">
    <div class="retail-s2__top" data-reveal>
      <h2 class="h2" id="lg-s2-heading" data-split>Throughput changes every shift. Most plans stay the same.</h2>
      <div class="retail-s2__intro">
        <p class="lead">Fixed shift plans can't keep up with inbound trucks, order peaks and absences. Workofo can.</p>
        <a class="textlink" href="#how">
          See how it works
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"></path></svg>
        </a>
      </div>
    </div>

    <div class="retail-s2__grid">
      <article class="retail-s2__card" data-reveal>
        <span class="retail-s2__ico">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 17l5-6 4 3 8-9"></path><path d="M15 5h5v5"></path></svg>
        </span>
        <h3 class="h3">Throughput you can't staff evenly</h3>
        <p class="txt">Pallets, orders and shipments arrive in peaks, not averages.</p>
        <p class="retail-s2__answer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#EE8068" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
