---
import type { Locale } from '../../lib/locales';

const { locale } = Astro.props as { locale: Locale };
const copy = {
  en: {
    heading: 'Service is a feeling.',
    body: 'The woman in the store sees that the customer needs help. She has time to listen and the knowledge to answer. Just as it is meant to work.',
    close: 'The right staffing gives more customers the same attention.',
  },
  se: {
    heading: 'Service är en känsla.',
    body: 'Kvinnan i butiken ser att kunden behöver hjälp. Hon har tid att lyssna och kunskap att svara. Precis som det är tänkt att fungera.',
    close: 'Rätt bemanning ger fler kunder samma uppmärksamhet.',
  },
  lt: {
    heading: 'Aptarnavimas – tai jausmas.',
    body: 'Parduotuvės darbuotoja pastebi, kad klientui reikia pagalbos. Ji turi laiko išklausyti ir žinių atsakyti į klausimus. Taip ir turėtų būti.',
    close: 'Tinkamai suplanavus pamainas, tokio pat dėmesio sulaukia daugiau klientų.',
  },
}[locale];
---

<section id="home-service" class="home-service" aria-labelledby="home-service-heading">
  <div class="home-service__card">
    <div class="home-service__copy">
      <h2 id="home-service-heading">{copy.heading}</h2>
      <p>{copy.body}</p>
      <p class="home-service__close">{copy.close}</p>
    </div>
  </div>
</section>

<style>
  .home-service {
    width: 100%;
    padding: 0 var(--gutter) clamp(12px, 1.75vw, 24px);
    background: #fff;
    scroll-margin-top: 108px;
  }

  .home-service__card {
    max-width: calc(var(--max) - 2 * var(--gutter));
    margin-inline: auto;
    padding: clamp(52px, 8vw, 108px) clamp(20px, 5vw, 64px);
    border-radius: 24px;
    background:
      radial-gradient(ellipse at 10% 0%, #ebd9d4 0%, transparent 48%),
      radial-gradient(ellipse at 66% 82%, #eadfd9 0%, transparent 53%),
      linear-gradient(145deg, #f5f4f2, #eaeae7);
  }

  .home-service__copy {
    max-width: 43rem;
    margin-inline: auto;
    text-align: center;
  }

  h2 {
    margin: 0 0 0.6em;
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 3.4vw, 2.75rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  p {
    margin: 0;
    color: #4a4f57;
    line-height: 1.6;
    text-wrap: balance;
  }

  .home-service__close {
    width: fit-content;
    margin: 1.5em auto 0;
    padding-top: 1.25em;
    border-top: 1px solid rgb(17 17 17 / 9%);
    color: #111;
    font-weight: 600;
  }

</style>
