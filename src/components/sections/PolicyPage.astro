---
import SiteLayout from '../../layouts/SiteLayout.astro';
import type { Locale } from '../../lib/locales';
import { localePath } from '../../lib/paths';
import { cookieCopy, privacyCopy } from '../../lib/policy-copy';
import { policyPages, type PolicyPageKey } from '../../lib/policies';

interface Props {
  locale: Locale;
  page: PolicyPageKey;
}

const { locale, page } = Astro.props;
const swedish = locale === 'se';
const policy = policyPages[page];
const title = policy[locale];
const sections = page === 'privacy' ? privacyCopy[locale] : cookieCopy[locale];
const relatedPage = page === 'privacy' ? 'cookie-policy' : 'privacy';
const readLabel = swedish ? 'Läs hela originaldokumentet (engelska)' : 'Read the full original document';
---

<SiteLayout locale={locale} title={`${title} | Workofo`} pathWithoutLang={`/${page}`}>
  <article class="policy">
    <h1>{title}</h1>

    {page !== 'system-requirements' && <>
      {sections.map(([heading, body]) => <section>
        <h2>{heading}</h2>
        <p>{body}</p>
      </section>)}
      <p><a href="mailto:contact@workofo.com">contact@workofo.com</a></p>
      <p><a data-legacy-cookie-target={page === 'privacy' ? '' : undefined} href={localePath(locale, '/' + relatedPage)}>{policyPages[relatedPage][locale]}</a></p>
    </>}

    {page === 'system-requirements' && <>
      <p>{swedish
        ? 'De tekniska specifikationerna för Workofo omfattar webbappen, medarbetarappen, terminaler för tidrapportering, inloggning och informationssäkerhet. Version 2.4, daterad 4 juni 2026.'
        : 'Workofo’s technical specification covers the web app, employee app, time clocks, sign-in and information security. Version 2.4, dated 4 June 2026.'}</p>
      <h2>{swedish ? 'Webbläsare och mobil' : 'Browsers and mobile'}</h2>
      <p>{swedish
        ? 'Webbappen stöder de två senaste stabila huvudversionerna av Chromium-baserade webbläsare, till exempel Chrome och Edge. Medarbetarappen finns för iPhone och Android. Se specifikationen för exakta versionskrav och nätverkskrav.'
        : 'The web app supports the two latest stable major releases of Chromium-based browsers such as Chrome and Edge. The employee app is available for iPhone and Android. The specification lists exact version and network requirements.'}</p>
    </>}

    <p class="policy__source"><a href={policy.source}>{page === 'cookie-policy' ? 'Wix – Cookies and Your Wix Site' : readLabel}</a></p>
  </article>
</SiteLayout>

<script>
  function followLegacyCookieLink() {
    const target = document.querySelector<HTMLAnchorElement>('[data-legacy-cookie-target]');
    if (target && window.location.hash === '#cookies') {
      window.location.replace(target.href);
    }
  }

  followLegacyCookieLink();
  window.addEventListener('hashchange', followLegacyCookieLink);
</script>

<style>
  .policy { width: min(calc(100% - 48px), 48rem); margin: 0 auto; padding: clamp(48px, 8vw, 104px) 0; }
  .policy h1 { margin: 0 0 24px; font-size: clamp(36px, 6vw, 60px); line-height: 1.08; text-wrap: balance; }
  .policy h2 { margin: 36px 0 10px; font-size: clamp(23px, 3vw, 30px); scroll-margin-top: 110px; }
  .policy p { margin: 0 0 16px; line-height: 1.65; }
  .policy a { text-decoration: underline; text-underline-offset: .2em; }
  .policy .policy__source { margin-top: 28px; }
</style>
