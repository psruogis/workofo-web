---
import HomeBottomCta from './HomeBottomCta.astro';

type Props = {
  demoHref: string;
  headingId?: string;
  title?: string;
  sub?: string;
  note?: string;
  tailoredSub?: string;
  bookedSub?: string;
  ariaLabel?: string;
};

const {
  demoHref,
  headingId,
  title = 'Book a demo built around your stores.',
  sub = "Bring your stores, roles and labor rules. We'll show you what Workofo would do with them.",
  note = "We'll get back to you to arrange your demo.",
} = Astro.props as Props;
---

<HomeBottomCta
  demoHref={demoHref}
  headingId={headingId}
  title={title}
  sub={sub}
  note={note}
/>
