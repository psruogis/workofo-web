---
type Props = {
  demoHref: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  headingId?: string;
  title?: string;
  sub?: string;
  note?: string;
};

const {
  demoHref,
  secondaryHref,
  secondaryLabel = 'See how it works',
  headingId = 'wf-cta-heading',
  title = 'See Workofo with your own demand data and scheduling rules.',
  sub = "Bring your demand patterns, roles and labour rules. Let's explore where better scheduling could make a difference.",
  note = "We'll get back to you to arrange your demo.",
} = Astro.props as Props;
---

<section class="home-cta" aria-labelledby={headingId}>
  <div class="home-cta__wrap">
    <div class="home-cta__card" data-reveal>
      <h2 class="home-cta__heading" id={headingId}>{title}</h2>
      <p class="home-cta__lead">{sub}</p>
      <div class="home-cta__actions">
        <a class="home-cta__button home-cta__button--primary" href={demoHref}>Book a demo</a>
        {secondaryHref && (
          <a class="home-cta__button home-cta__button--secondary" href={secondaryHref}>
            {secondaryLabel}
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M7 2.5v9M3.5 8 7 11.5 10.5 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        )}
      </div>
      {note && <p class="home-cta__note">{note}</p>}
    </div>
  </div>
</section>

<style>
  .home-cta { box-sizing: border-box; width: 100%; padding: 112px 0; background: #fff; color: #fff; }
  .home-cta__wrap { box-sizing: border-box; width: 100%; max-width: 1440px; margin: 0 auto; padding: 0 56px; }
  .home-cta__card {
    box-sizing: border-box; display: flex; flex-direction: column; align-items: center;
    width: 100%; padding: 78px 48px 68px; border-radius: 28px; text-align: center;
    background: radial-gradient(620px 360px at 50% 0%, rgba(255,255,255,.065), transparent 75%), #111;
  }
  .home-cta__heading {
    max-width: 740px; margin: 0; color: #fff; font-family: var(--font-display);
    font-size: clamp(34px, 3.8vw, 48px); font-weight: 600; line-height: 1.12;
    letter-spacing: -.025em; text-wrap: balance;
  }
  .home-cta__lead {
    max-width: 540px; margin: 20px 0 0; color: rgba(255,255,255,.72);
    font-family: var(--font-sans); font-size: 16px; line-height: 1.55;
  }
  .home-cta__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 32px; }
  .home-cta__button {
    box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 48px; padding: 0 24px; border: 1px solid; border-radius: 999px;
    font-family: var(--font-sans); font-size: 14px; font-weight: 500; line-height: 1; text-decoration: none;
  }
  .home-cta__button--primary { border-color: #fff; background: #fff; color: #111; }
  .home-cta__button--primary:hover { background: #ecece8; }
  .home-cta__button--secondary { border-color: rgba(255,255,255,.35); background: transparent; color: #fff; }
  .home-cta__button--secondary:hover { border-color: #fff; }
  .home-cta__button:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .home-cta__note { margin: 14px 0 0; color: rgba(255,255,255,.52); font-family: var(--font-sans); font-size: 12px; line-height: 1.4; }
  @media (max-width: 900px) {
    .home-cta { padding: 64px 0; }
    .home-cta__wrap { padding: 0 16px; }
    .home-cta__card { padding: 56px 24px; border-radius: 24px; }
    .home-cta__heading { font-size: clamp(30px, 7vw, 40px); }
  }
  @media (max-width: 480px) {
    .home-cta__card { padding: 48px 20px; }
    .home-cta__lead { font-size: 15px; }
    .home-cta__actions { width: 100%; }
    .home-cta__button { width: 100%; }
  }
</style>
