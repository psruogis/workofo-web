---
type Props = {
  demoHref: string;
  secondaryHref: string;
};

const { demoHref, secondaryHref } = Astro.props as Props;
---

<section class="home-cta" aria-labelledby="wf-cta-heading">
  <div class="home-cta__wrap">
    <div class="home-cta__card" data-reveal>
      <div class="home-cta__copy">
        <h2 class="home-cta__heading" id="wf-cta-heading">See Workofo with your own demand data and scheduling rules.</h2>
        <p class="home-cta__lead">Bring your demand patterns, roles and labour rules. Let's explore where better scheduling could make a difference.</p>
        <div class="home-cta__actions">
          <a class="home-cta__button home-cta__button--primary" href={demoHref}>Book a demo</a>
          <a class="home-cta__button home-cta__button--secondary" href={secondaryHref}>
            See how it works
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M7 2.5v9M3.5 8 7 11.5 10.5 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        </div>
        <p class="home-cta__note">We'll get back to you to arrange your demo.</p>
      </div>

      <div class="home-cta__visual">
        <div class="home-cta__demo" role="img" aria-label="Your demo request: request received, demo tailored to your demand data, roles and labour rules, then demo booked.">
          <div class="home-cta__demo-head">
            <span class="home-cta__demo-title">Your demo</span>
            <span class="home-cta__status">
              <span class="home-cta__status-progress"><i aria-hidden="true"></i>In progress</span>
              <span class="home-cta__status-booked"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>Booked</span>
            </span>
          </div>
          <div class="home-cta__timeline">
            <span class="home-cta__rail" aria-hidden="true"><i></i></span>
            <div class="home-cta__step home-cta__step--received">
              <span class="home-cta__node" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg></span>
              <div class="home-cta__step-body">
                <div class="home-cta__step-row"><span class="home-cta__step-title">Request received</span></div>
                <p class="home-cta__step-detail">We've got your details</p>
              </div>
            </div>
            <div class="home-cta__step home-cta__step--tailored">
              <span class="home-cta__node" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg></span>
              <div class="home-cta__step-body">
                <div class="home-cta__step-row"><span class="home-cta__step-title">Demo tailored</span></div>
                <p class="home-cta__step-detail">Built around your</p>
                <div class="home-cta__chips"><span>Demand data</span><span>Roles</span><span>Labour rules</span></div>
              </div>
            </div>
            <div class="home-cta__step home-cta__step--booked">
              <span class="home-cta__node" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg></span>
              <div class="home-cta__step-body home-cta__step-body--card">
                <div class="home-cta__step-row"><span class="home-cta__step-title">Demo booked</span></div>
                <p class="home-cta__step-detail">Walkthrough with your own data</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .home-cta { box-sizing: border-box; width: 100%; padding: 112px 0; background: #fff; color: #fff; }
  .home-cta__wrap { box-sizing: border-box; width: 100%; max-width: 1440px; margin: 0 auto; padding: 0 56px; }
  .home-cta__card {
    position: relative; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
    align-items: center; gap: 72px; box-sizing: border-box; overflow: hidden;
    padding: 80px; border-radius: 28px;
    background: radial-gradient(560px 460px at 78% 55%, rgba(255,255,255,.07), transparent 70%), #111;
  }
  .home-cta__heading {
    margin: 0; max-width: 34rem; font-family: var(--font-display); font-size: 48px;
    font-weight: 600; line-height: 1.12; letter-spacing: -.025em; color: #fff;
  }
  .home-cta__lead {
    margin: 20px 0 0; max-width: 28rem; font-family: var(--font-sans);
    font-size: 19.2px; line-height: 1.6; color: rgba(255,255,255,.64);
  }
  .home-cta__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 16px; margin-top: 36px; }
  .home-cta__button {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    box-sizing: border-box; height: 52px; padding: 0 26px; border: 1px solid;
    border-radius: 999px; font-family: var(--font-sans); font-size: 15.2px;
    font-weight: 500; line-height: 1; text-decoration: none;
  }
  .home-cta__button--primary { background: #fff; border-color: #fff; color: #111; }
  .home-cta__button--primary:hover { background: #ecece8; }
  .home-cta__button--secondary { background: transparent; border-color: rgba(255,255,255,.4); color: #fff; }
  .home-cta__button--secondary:hover { border-color: #fff; }
  .home-cta__button:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .home-cta__note { margin: 16px 0 0; font-family: var(--font-sans); font-size: 13px; line-height: 1.4; color: rgba(255,255,255,.5); }
  .home-cta__visual { display: flex; justify-content: flex-end; min-width: 0; }
  .home-cta__demo {
    position: relative; box-sizing: border-box; width: 100%; max-width: 440px;
    padding: 24px 24px 34px; border: 1px solid rgba(255,255,255,.09);
    border-radius: 24px; background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.025));
    box-shadow: 0 40px 80px -40px rgba(0,0,0,.9), inset 0 1px 0 rgba(255,255,255,.06);
  }
  .home-cta__demo-head {
    display: flex; align-items: center; justify-content: space-between;
    padding-bottom: 20px; margin-bottom: 22px; border-bottom: 1px solid rgba(255,255,255,.08);
  }
  .home-cta__demo-title { font-family: var(--font-sans); font-size: 15px; font-weight: 600; line-height: 1; }
  .home-cta__status { position: relative; display: inline-grid; height: 28px; font-family: var(--font-sans); font-size: 12.5px; font-weight: 500; line-height: 1; }
  .home-cta__status-progress, .home-cta__status-booked {
    grid-area: 1 / 1; display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    padding: 0 12px; border-radius: 999px; white-space: nowrap;
  }
  .home-cta__status-progress { background: rgba(255,255,255,.07); color: rgba(255,255,255,.7); animation: home-cta-status-progress 10s infinite; }
  .home-cta__status-booked { opacity: 0; background: #fff; color: #111; animation: home-cta-status-booked 10s infinite; }
  .home-cta__status-progress i { width: 6px; height: 6px; border-radius: 50%; background: #df5c46; animation: home-cta-blink 1.2s ease-in-out infinite; }
  .home-cta__timeline { position: relative; display: flex; flex-direction: column; gap: 20px; }
  .home-cta__rail { position: absolute; left: 11px; top: 14px; bottom: 30px; width: 2px; overflow: hidden; border-radius: 2px; background: rgba(255,255,255,.1); }
  .home-cta__rail i { display: block; width: 100%; height: 100%; background: #df5c46; transform-origin: top; animation: home-cta-rail 10s cubic-bezier(.4,0,.2,1) infinite; }
  .home-cta__step { position: relative; display: grid; grid-template-columns: 24px minmax(0,1fr); gap: 16px; align-items: start; }
  .home-cta__node {
    position: relative; z-index: 1; display: flex; align-items: center; justify-content: center;
    box-sizing: border-box; width: 24px; height: 24px; margin-top: 2px;
    border: 1.5px solid rgba(255,255,255,.22); border-radius: 50%;
    background: #151515; color: transparent;
  }
  .home-cta__step--received .home-cta__node { animation: home-cta-node-one 10s infinite; }
  .home-cta__step--tailored .home-cta__node { animation: home-cta-node-two 10s infinite; }
  .home-cta__step--booked .home-cta__node { animation: home-cta-node-three 10s infinite; }
  .home-cta__step-body { min-width: 0; opacity: .38; }
  .home-cta__step--received .home-cta__step-body { animation: home-cta-body-one 10s infinite; }
  .home-cta__step--tailored .home-cta__step-body { animation: home-cta-body-two 10s infinite; }
  .home-cta__step--booked .home-cta__step-body { animation: home-cta-body-three 10s infinite; }
  .home-cta__step-row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .home-cta__step-title { font-family: var(--font-sans); font-size: 15px; font-weight: 600; line-height: 1.3; color: #fff; }
  .home-cta__step-detail { margin: 4px 0 0; font-family: var(--font-sans); font-size: 13.5px; line-height: 1.45; color: rgba(255,255,255,.58); }
  .home-cta__chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .home-cta__chips span {
    display: inline-flex; align-items: center; height: 26px; padding: 0 10px;
    border: 1px solid rgba(255,255,255,.1); border-radius: 8px;
    background: rgba(255,255,255,.06); color: rgba(255,255,255,.85);
    font-family: var(--font-sans); font-size: 12px; font-weight: 500; line-height: 1;
    opacity: 0; animation: home-cta-chip 10s infinite;
  }
  .home-cta__chips span:nth-child(2) { animation-delay: .25s; }
  .home-cta__chips span:nth-child(3) { animation-delay: .5s; }
  .home-cta__step-body--card { margin: -10px 0 -12px -8px; padding: 10px 14px 12px 8px; border-radius: 14px; }
  .home-cta__step--booked .home-cta__step-title { animation: home-cta-booked-title 10s infinite; }
  .home-cta__step--booked .home-cta__step-detail { animation: home-cta-booked-detail 10s infinite; }
  @keyframes home-cta-blink { 50% { opacity: .25; } }
  @keyframes home-cta-status-progress { 0%, 56%, 96%, 100% { opacity: 1; } 60%, 92% { opacity: 0; } }
  @keyframes home-cta-status-booked { 0%, 56%, 96%, 100% { opacity: 0; transform: scale(.9); } 60%, 92% { opacity: 1; transform: none; } }
  @keyframes home-cta-rail { 0%, 5% { transform: scaleY(0); } 30% { transform: scaleY(.5); } 55%, 92% { transform: scaleY(1); } 97%, 100% { transform: scaleY(0); } }
  @keyframes home-cta-node-one { 0%, 4%, 97%, 100% { background: #151515; border-color: rgba(255,255,255,.22); color: transparent; } 7%, 92% { background: #df5c46; border-color: #df5c46; color: #fff; } }
  @keyframes home-cta-node-two { 0%, 29%, 97%, 100% { background: #151515; border-color: rgba(255,255,255,.22); color: transparent; } 32%, 92% { background: #df5c46; border-color: #df5c46; color: #fff; } }
  @keyframes home-cta-node-three { 0%, 54%, 97%, 100% { background: #151515; border-color: rgba(255,255,255,.22); color: transparent; } 57%, 92% { background: #fff; border-color: #fff; color: #111; } }
  @keyframes home-cta-body-one { 0%, 4%, 97%, 100% { opacity: .38; } 7%, 92% { opacity: 1; } }
  @keyframes home-cta-body-two { 0%, 29%, 97%, 100% { opacity: .38; } 32%, 92% { opacity: 1; } }
  @keyframes home-cta-body-three { 0%, 54%, 97%, 100% { opacity: .38; background: transparent; box-shadow: none; } 57%, 92% { opacity: 1; background: #fff; box-shadow: 0 24px 48px -20px rgba(0,0,0,.7), 0 0 0 6px rgba(255,255,255,.05); } }
  @keyframes home-cta-booked-title { 0%, 54%, 97%, 100% { color: #fff; } 57%, 92% { color: #111; } }
  @keyframes home-cta-booked-detail { 0%, 54%, 97%, 100% { color: rgba(255,255,255,.58); } 57%, 92% { color: #5a5e64; } }
  @keyframes home-cta-chip { 0%, 33%, 97%, 100% { opacity: 0; transform: translateY(4px); } 36%, 92% { opacity: 1; transform: none; } }
  @media (max-width: 900px) {
    .home-cta { padding: 64px 0; }
    .home-cta__wrap { padding: 0 16px; }
    .home-cta__card { grid-template-columns: 1fr; gap: 40px; padding: 44px 24px 28px; border-radius: 24px; }
    .home-cta__heading { font-size: 34px; }
    .home-cta__lead { font-size: 16px; }
    .home-cta__visual { justify-content: stretch; }
    .home-cta__demo { max-width: none; padding: 20px 18px 28px; }
    .home-cta__chips span { height: 24px; padding: 0 8px; font-size: 11.5px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-cta__demo * { animation: none !important; }
    .home-cta__status-progress { opacity: 0; }
    .home-cta__status-booked { opacity: 1; }
    .home-cta__rail i { transform: none; }
    .home-cta__step-body, .home-cta__chips span { opacity: 1; }
    .home-cta__node { background: #df5c46; border-color: #df5c46; color: #fff; }
    .home-cta__step--booked .home-cta__node, .home-cta__step-body--card { background: #fff; }
    .home-cta__step--booked .home-cta__node, .home-cta__step--booked .home-cta__step-title { color: #111; }
    .home-cta__step--booked .home-cta__step-detail { color: #5a5e64; }
  }
</style>
