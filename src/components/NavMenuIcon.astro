---
/**
 * Stroke icons for Product mega menu — paths from ProductMenu.dc.html.
 */
type IconName =
  | 'forecast'
  | 'calendar'
  | 'shield'
  | 'spark'
  | 'chart'
  | 'transfer'
  | 'chat'
  | 'phone'
  | 'swap'
  | 'arrow';

type Props = {
  name: IconName;
  size?: number;
};

const { name, size = 18 } = Astro.props;
const stroke = name === 'arrow' ? 2.2 : 1.7;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'forecast' && (
      <>
        <path d="M3 17l5-6 4 3 8-9"></path>
        <path d="M15 5h5v5"></path>
      </>
    )
  }
  {
    name === 'calendar' && (
      <>
        <rect x="3" y="5" width="18" height="16" rx="2"></rect>
        <path d="M3 10h18M8 3v4M16 3v4"></path>
      </>
    )
  }
  {
    name === 'shield' && (
      <>
        <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"></path>
        <path d="M9 12l2 2 4-4"></path>
      </>
    )
  }
  {
    name === 'spark' && (
      <>
        <path d="M12 3l1.8 4.2L18 9l-4.2 1.8L12 15l-1.8-4.2L6 9l4.2-1.8z"></path>
        <path d="M19 15l.8 1.7 1.7.8-1.7.8L19 20l-.8-1.7-1.7-.8 1.7-.8z"></path>
      </>
    )
  }
  {
    name === 'chart' && (
      <>
        <path d="M3 3v18h18"></path>
        <path d="M7 15c3-6 6 2 10-6"></path>
      </>
    )
  }
  {
    name === 'transfer' && (
      <>
        <path d="M4 8h14M14 4l4 4-4 4"></path>
        <path d="M20 16H6M10 12l-4 4 4 4"></path>
      </>
    )
  }
  {
    name === 'chat' && (
      <>
        <path d="M21 12a8 8 0 01-11.6 7.1L4 20l1-4.6A8 8 0 1121 12z"></path>
        <path d="M9 11h.01M12 11h.01M15 11h.01"></path>
      </>
    )
  }
  {
    name === 'phone' && (
      <>
        <rect x="7" y="2.5" width="10" height="19" rx="2.5"></rect>
        <path d="M11 18.5h2"></path>
      </>
    )
  }
  {
    name === 'swap' && (
      <>
        <path d="M7 4L3 8l4 4"></path>
        <path d="M3 8h14"></path>
        <path d="M17 20l4-4-4-4"></path>
        <path d="M21 16H7"></path>
      </>
    )
  }
  {
    name === 'arrow' && (
      <>
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </>
    )
  }
</svg>
