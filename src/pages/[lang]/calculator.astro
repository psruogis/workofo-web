---
/**
 * Prefixed Calculator for SE/LT chrome. English content first.
 * `/en/calculator` redirects to unprefixed `/calculator`.
 */
import SiteLayout from '../../layouts/SiteLayout.astro';
import CalculatorPage from '../../components/sections/CalculatorPage.astro';
import { isLocale, type Locale } from '../../lib/locales';
import { listNavPages } from '../../lib/cms';

const rawLang = Astro.params.lang;
if (!isLocale(rawLang)) {
  return Astro.redirect('/calculator', 302);
}

const locale = rawLang as Locale;
if (locale === 'en') {
  return Astro.redirect('/calculator', 301);
}

const navPages = await listNavPages(locale);
---

<SiteLayout
  locale={locale}
  title="Capacity calculator | Workofo"
  description="Estimate the hours and capacity value locked in your current schedules. Adjust workforce inputs and see what demand-driven scheduling could unlock."
  pathWithoutLang="/calculator"
  navPages={navPages}
>
  <CalculatorPage locale={locale} />
</SiteLayout>
