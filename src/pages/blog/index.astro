---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { ui } from '../../lib/locales';
import { listBlogPosts } from '../../lib/blog';
import { listNavPages } from '../../lib/cms';
import { localePath } from '../../lib/paths';
import BlogArchive from '../../components/sections/BlogArchive.astro';
import HomeBottomCta from '../../components/sections/HomeBottomCta.astro';

const locale = 'en' as const;
const { posts: blogPosts, error } = await listBlogPosts(100);
const navPages = await listNavPages(locale);
---

<SiteLayout locale={locale} title={ui('blog', locale)} pathWithoutLang="/blog" navPages={navPages}>
  <BlogArchive posts={blogPosts} error={error} locale={locale} />
  <HomeBottomCta demoHref={localePath(locale, '/get-in-touch')} secondaryHref={`${localePath(locale, '/')}#home-features`} />
</SiteLayout>
